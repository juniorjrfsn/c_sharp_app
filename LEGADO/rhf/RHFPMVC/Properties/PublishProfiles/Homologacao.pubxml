<Project>
  <PropertyGroup>
    <WebPublishMethod>MSDeploy</WebPublishMethod>
    <LaunchSiteAfterPublish>true</LaunchSiteAfterPublish>
    <LastUsedBuildConfiguration>Debug</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <SiteUrlToLaunchAfterPublish>
    </SiteUrlToLaunchAfterPublish>
    <ExcludeApp_Data>false</ExcludeApp_Data>
    <MSDeployServiceURL>https://hom2.deploy.ms.gov.br:8172/msdeploy.axd</MSDeployServiceURL>
    <DeployIisAppPath>hom.rhfp.ageprev.ms.gov.br</DeployIisAppPath>
    <RemoteSitePhysicalPath />
    <SkipExtraFilesOnServer>true</SkipExtraFilesOnServer>
    <MSDeployPublishMethod>WMSVC</MSDeployPublishMethod>
    <EnableMSDeployBackup>true</EnableMSDeployBackup>
    <EnableMsDeployAppOffline>false</EnableMsDeployAppOffline>
    <UserName>ADMINISTRACAO\imiranda</UserName>
    <_SavePWD>false</_SavePWD>
    <_TargetId>IISWebDeploy</_TargetId>
    <PublishDatabaseSettings>
      <Objects>
        <ObjectGroup Name="OracleDb" Order="2" Enabled="False">
          <Destination Path="" />
          <Object Type="DbDacFx">
            <PreSource Path="Data Source=(DESCRIPTION=(ADDRESS_LIST=(ADDRESS=(PROTOCOL=TCP)(HOST=10.2.11.157)(PORT=1521)))(CONNECT_DATA=(SERVICE_NAME=RHPROD)));User Id=ageprev;Password=@geprev2008;" includeData="False" />
            <Source Path="$(IntermediateOutputPath)AutoScripts\OracleDb_IncrementalSchemaOnly.dacpac" dacpacAction="Deploy" />
          </Object>
          <UpdateFrom Type="Web.Config">
            <Source MatchValue="Data Source=(DESCRIPTION=(ADDRESS_LIST=(ADDRESS=(PROTOCOL=TCP)(HOST=10.2.11.157)(PORT=1521)))(CONNECT_DATA=(SERVICE_NAME=RHPROD)));User Id=ageprev;Password=@geprev2008;" MatchAttributes="$(UpdateFromConnectionStringAttributes)" />
          </UpdateFrom>
        </ObjectGroup>
        <ObjectGroup Name="RHFPContext" Order="3" Enabled="False">
          <Destination Path="" />
          <Object Type="DbCodeFirst">
            <Source Path="DBContext" DbContext="RHFP.ModelData.Database.Entity.RHFPContext, RHFP.ModelData" Origin="Configuration" />
          </Object>
        </ObjectGroup>
      </Objects>
    </PublishDatabaseSettings>
  </PropertyGroup>
  <ItemGroup>
    <MSDeployParameterValue Include="$(DeployParameterPrefix)OracleDb-Web.config Connection String" />
    <MSDeployParameterValue Include="$(DeployParameterPrefix)RHFPContext-Web.config Connection String" />
    <MSDeployParameterValue Include="SigEventosContext-Web.config Connection String">
      <ParameterValue>metadata=res://*/Database.Entity.SigEventosModel.csdl|res://*/Database.Entity.SigEventosModel.ssdl|res://*/Database.Entity.SigEventosModel.msl;provider=System.Data.SqlClient;provider connection string="Data Source=S0676.MS;Initial Catalog=pms_eventos_homologacao;Persist Security Info=True;User ID=pms_sigeventos;Password=NQ5FC2F2N0W8"</ParameterValue>
    </MSDeployParameterValue>
  </ItemGroup>
</Project>