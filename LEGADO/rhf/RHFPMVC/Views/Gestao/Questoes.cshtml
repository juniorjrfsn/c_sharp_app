<!-- ============================================================== -->
<!-- Container fluid  -->
<!-- ============================================================== -->

<div class="container-fluid" style="padding-top:2px;">
    <div class="row">
        <!-- column -->
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="card">
                <div class="card-body">
                    <div class="body-content">
                        
                        <input type="hidden" name="usr_num_usuario" id="usr_num_usuario" value="0" />
                        <input type="hidden" name="eve_num_evento" id="eve_num_evento" value="@ViewBag.eve_num_evento" />
                        <input type="hidden" name="que_num_questionario" id="que_num_questionario" value="@ViewBag.que_num_questionario" />
    
                        <div class="process-info">
                            <div class="form-group" style="display:none;">
                                <h1>Detalhes do Movimento</h1>

                            </div>

                        </div>
                        <div class="row">
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 ">
                                @*<h1 class="mb-4">Questionario</h1>*@

                                <div id="eventos-questionario"></div>



                                <div id="content-table-questoes">

                                    <div class="form-row">
                                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12" style="text-align:right;">
                                            <button class="btn btn-primary" name="btn-abrir-cadastro" id="btn-abrir-cadastro" type="submit">
                                                <i class="fa-solid fa-plus fa-lg"></i>  Adicionar Nova Questão
                                            </button>
                                        </div>
                                    </div>
                                    <br />
                                    <table id="table-lista-questoes" class="table table-striped">
                                        <thead style="width: 100%;">
                                            <tr>
                                                <th style="width: 80px; text-align: center; ">N. Questão</th>
                                                <th style="width: auto; text-align: center; ">Enunciado</th>
                                                <th style="width: 80px; text-align: center; ">Situação</th>
                                                <th style="width: 80px; text-align: center; ">Editar</th>
                                                <th style="width: 80px; text-align: center; ">Cancelar</th>
                                            </tr>
                                        </thead>
                                        <tbody id="table-lista-questoes-itens" style="width: 100%;"></tbody>
                                        <tfoot style="width: 100%;">
                                            <tr>
                                                <th></th>
                                                <th></th>
                                                <th></th>
                                                <th></th>
                                                <th></th>
                                            </tr>
                                        </tfoot>
                                    </table>

                                </div>

                                <div id="content-cad-questao" style="display:none;">
                                    <form name="formCadQuestao" id="formCadQuestao" action="" method="post" style="width:100%;">
                                        
                                        <input type="hidden" name="qst_num_questao" id="qst_num_questao" value="0" />

                                        <div class="form-group">
                                            <div class="form-row">

                                                <div class="col-md-12 mb-3" style="text-align:center;">
                                                    <h4><span style="font-weight:500;">Questão</span></h4>
                                                    <br />
                                                </div>
                                            </div>
                                            <div class="form-row">
                                                <div class="col-md-12 mb-3">
                                                    <label for="qst_enunciado">Enunciado</label>
                                                    <textarea class="form-control" rows="4" name="qst_enunciado" id="qst_enunciado" placeholder="Enunciado" required></textarea>
                                                    <div class="invalid-feedback">
                                                        Por favor preencher este campo
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="form-row">
                                                <div class="col-md-12 mb-3">
                                                    <label for="qst_situacao">Situação</label>
                                                    <select class="form-control" name="qst_situacao" id="qst_situacao" required>
                                                        <option value=""> -- Selecione --</option>
                                                        <option value="A" selected="selected">Ativo</option>
                                                        <option value="I">Inativo</option>
                                                        <option value="C">Cancelado</option>
                                                    </select>
                                                    <div class="invalid-feedback">
                                                        Por favor preencher este campo
                                                    </div>
                                                </div>
                                            </div>


                                            <div class="form-row">
                                                <div class="col-md-6" style="text-align:left;">
                                                    <br />
                                                    <h4><span style="font-weight:500;">Respostas</span></h4>
                                                    <br />
                                                </div>

                                                <div class="col-md-6" style="text-align:right;">
                                                    <br />
                                                    <button class="btn btn-primary" name="btn-adicionar-resposta-registro" id="btn-adicionar-resposta-registro" type="button">
                                                        <i class="fa-solid fa-plus fa-lg"></i>  Adicionar Resposta
                                                    </button>
                                                    <br />
                                                </div>
                                            </div>

                                            <div class="form-row">

                                                <div class="col-md-12 mb-3" id="content-cad-questao-resposta">
                                                    <table id="table-lista-respostas" class="table table-striped">
                                                        <thead>
                                                            <tr>
                                                                <th>N. Questão</th>
                                                                <th>N. Resposta</th>
                                                                <th>Enunciado</th>
                                                                <th>Correta</th>
                                                                <th>Situação</th>
                                                                <th>Editar</th>
                                                                <th>Cancelar</th>
                                                                <th>Remover</th>
                                                            </tr>
                                                        </thead>
                                                        <tboy></tboy>
                                                    </table>
                                                </div>
                                            </div>


                                            <table style="width: 100%;">
                                                <tr>
                                                    <td>
                                                        <button class="btn btn-primary" name="btn-salvar-questao" id="btn-salvar-questao" type="button">
                                                            <i class="fa-regular fa-floppy-disk"></i>  Salvar
                                                        </button>
                                                    </td>
                                                    <td style="text-align:right;">
                                                        <button class="btn btn-primary" name="btn-fechar-cadastro" id="btn-fechar-cadastro" type="button">
                                                            <i class="fa-solid fa-left-long"></i>   Voltar
                                                        </button>
                                                    </td>
                                                </tr>
                                            </table>


                                        </div>
                                    </form>

                                </div>


                                <div id="content-table" style="display:none;">

                                    <table style="width: 100%;">
                                        <tr>
                                            <td style="max-width: 500px; width: 500px;">
                                                <div class="form-group">
                                                    <div class="input-group mb-3">
                                                        <input type="hidden" name="busca" id="busca" value="">
                                                        <div class="input-group-prepend">
                                                            <span class="input-group-text" id="basic-addon1">Pesquisar</span>
                                                        </div>
                                                        <input type="text" class="form-control" placeholder="" aria-label="buscar" aria-describedby="basic-addon1" name="buscaLimpa" id="buscaLimpa" style="width: 400px; max-width: 400px;">
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                <div class="form-group">
                                                    <div class="input-group mb-3">
                                                        <button type="button" class="btn btn-light" name="btnBuscar" id="btnBuscar">
                                                            <i class="fa-solid fa-magnifying-glass fa-lg"></i>
                                                        </button>
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                    </table>

                                    <!--div class="text-center">
                    <h2 class="mb-4">Notas por usuário</h2>
                </div-->

                                    <table id="table-lista-itens" class="table table-striped">
                                        <thead style="width: 100%;">
                                            <tr>
                                                <th></th>
                                                <th></th>
                                                <th></th>
                                                <th></th>
                                                <th></th>
                                            </tr>
                                        </thead>
                                        <tbody id="tb-itens" style="width: 100%;"></tbody>
                                        <tfoot style="width: 100%;">
                                            <tr>
                                                <th>CPF</th>
                                                <th>Nome</th>
                                                <th>Evento</th>
                                                <th>Pontuação</th>
                                                <th></th>
                                            </tr>
                                        </tfoot>
                                    </table>
                                    <!-- Data tables -->


                                </div>






                            </div>
                        </div>
                        <br />
                        <div class="row">
                            <div class="col-lg-6 col-md-6 col-sm-6 col-xs-6" style="text-align:left;">
                                <div class="buttons">
                                    <!--<button type="submit" name="btnReload" id="btnReload" style="display:none;"></button>
                <button type="submit" class="btn btn-primary" name="btnAvancar" style="display:none;">Avançar</button>
                <button type="button" class="btn btn-primary" name="btnVoltarItemMovimento" id="btnVoltarItemMovimento">Voltar</button>
                <button type="button" class="btn btn-primary" name="btnSalvarItemMovimento" id="btnSalvarItemMovimento">Salvar</button>-->
                                    <!--button type="button" class="btn btn-primary" name="btnAtualizarResumo" id="btnAtualizarResumo">Atualizar Resumo</button-->
                                    <!--<button type="button" class="btn btn-primary" name="btnGerarPlanilha" id="btnGerarPlanilha">Gerar Planilha</button>
                <button type="button" class="btn btn-primary" name="btnSairItemMovimento" id="btnSairItemMovimento">Sair</button>-->
                                </div>
                            </div>
                            @*<div class="col-lg-6 col-md-6 col-sm-6 col-xs-6" style="text-align:right;">
            <button type="button" name="gerar-novo-item" id="gerar-novo-item" class="btn btn-primary"><i class="fa-solid fa-plus"></i> Novo Item</button>
            </div>*@
                        </div>


                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<style type="text/css">

    /*
     Ini: Tabela de Lista de Questões
    */

    table#table-lista-eventos thead tr th {
        font-family: 'Lucida Sans', 'Lucida Sans Regular', 'sans-serif';
        padding: 5px 2px 5px 2px;
        font-size: 14px;
        text-align: center;
    }

    table#table-lista-respostas td.qsr_enunciado {
        width: 70%;
        min-width: 70%;
    }

    table#table-lista-itens thead tr th, table#table-lista-eventos thead tr th, table#table-lista-eventos tfoot tr th, table#table-lista-respostas thead tr th {
        text-align: center;
    }

    table#table-lista-eventos tbody tr td, table#table-lista-eventos tfoot tr th {
        font-family: 'Lucida Sans', 'Lucida Sans Regular', 'sans-serif';
        font-size: 12px;
        padding: 5px 2px 5px 2px;
    }

    table#table-lista-questoes thead tr th:nth-child(1), 
    table#table-lista-questoes tbody tr td:nth-child(1),
    table#table-lista-questoes tfoot tr th:nth-child(1) {
        width: 80px;
        max-width: 100px;
        text-align: center;
    }
    table#table-lista-questoes tbody tr td:nth-child(1) input[type="text"] {
        text-align: center;
    }


    table#table-lista-questoes thead tr th:nth-child(2),
    table#table-lista-questoes tbody tr td:nth-child(2),
    table#table-lista-questoes tfoot tr th:nth-child(2) {
        width: 55%;
        text-align: left;
    }

    table#table-lista-questoes thead tr th:nth-child(3),
    table#table-lista-questoes tbody tr td:nth-child(3),
    table#table-lista-questoes tfoot tr th:nth-child(3) {
        width: 100px;
        text-align: center;
    }

    table#table-lista-questoes thead tr td:nth-child(4),
    table#table-lista-questoes tbody tr td:nth-child(4),
    table#table-lista-questoes tfoot tr th:nth-child(4) {
        width: 100px;
        text-align: center;
    }

    table#table-lista-questoes thead tr td:nth-child(5),
    table#table-lista-questoes tbody tr td:nth-child(5),
    table#table-lista-questoes tfoot tr th:nth-child(5) {
        width: 100px;
        text-align: center;
    }
    /*
     Fim: Tabela de Lista de Questões
    */



    table#table-lista-itens {
        margin: 0px 0px 0px 0px;
    }
    table#table-lista-itens tfoot tr {
        max-height: 20px;
        height: 15px;
    }
      
    /*table#table-lista-itens thead tr th:nth-child(1), table#table-lista-itens thead tr th:nth-child(2), table#table-lista-itens thead tr th:nth-child(3), table#table-lista-itens thead tr th:nth-child(4), table#table-lista-itens thead tr th:nth-child(5) {
        text-align: center;
    }*/
    table#table-lista-itens tfoot tr th  {
        text-align: center;
    }
    /*table#table-lista-itens thead tr th:nth-child(1), table#table-lista-itens tbody tr td:nth-child(1), table#table-lista-itens tfoot tr th:nth-child(1){
        max-width: 130px;
    }*/

    table#table-lista-questoes tbody tr td:nth-child(1), table#table-lista-questoes tbody tr td:nth-child(1), table#table-lista-questoes tfoot tr th:nth-child(1) {
        width: 300px;
    }
   
 
    table#table-lista-itens tbody tr td input[type="text"] { 
        text-align: center;
    }



    table#table-lista-questoes thead tr th:nth-child(4),
    table#table-lista-questoes tbody tr td:nth-child(4), table#table-lista-questoes tbody tr td:nth-child(4) input[type="text"],
    table#table-lista-questoes tfoot tr th:nth-child(4) {
        text-align: center;
        max-width: 50px;
    }


    table#table-lista-questoes thead tr th:nth-child(5), table#table-lista-questoes tbody tr td:nth-child(5), table#table-lista-questoes tfoot tr th:nth-child(5) {
        text-align: center;
        max-width: 50px;
    }




        /** Datatable CSS **/
    #tableListaMov_wrapper input.search {
        height: 20px;
    }

    div.dt-container .dt-search input {
        height: 25px;
        width: 260px;
    }

        div.dt-container .dt-search input::placeholder {
            font-size: 14px;
        }

    .dt-buttons button {
        width: 55px;
        height: 25px;
        padding: 2px 2px 2px 2px;
        float: left;
        max-height: 25px;
    }

        .dt-buttons button svg {
            height: 18px;
        }

    div.dt-buttons > .dt-button, div.dt-buttons > div.dt-button-split.dt-button {
        padding: 2px 5px 2px 5px;
        width: 55px;
        height: 25px;
    }

    .dt-search input::placeholder {
        font-size: 9px;
    }


    .excluirItem {
        cursor: pointer;
    }

    .cancelarItemMovimento {
        cursor: pointer;
    }

    .footer {
     
        position: page;
        bottom: 0;
    }

</style>
<script src="/Content/controls/js/script-page/gestao-questoes.js?v=0.000000000000005"></script>

 