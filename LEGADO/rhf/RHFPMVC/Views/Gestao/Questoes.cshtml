@{
    ViewBag.Title = "Questões";
}
<script src="/Content/jQuery-Mask-Plugin-master/dist/jquery.mask.min.js"></script>
<script src="/Content/controls/js/config-scripts/config.js"></script>
<script src="/Content/controls/js/config-scripts/ScriptsConfig.js?v=0.00000000005"></script>

<style type="text/css">
    ul > li, ul > li input, ul > li div, ul > li label {
        cursor: pointer;
    }

        ul > li label {
            width: 99%;
        }
</style>

<!-- ============================================================== -->
<!-- Bread crumb and right sidebar toggle -->
<!-- ============================================================== -->
<div class="page-breadcrumb">
    <div class="row">
        <div class="col-5 align-self-center">
            <h4 class="page-title">Questões</h4>
        </div>
        <div class="col-7 align-self-center">
            <div class="d-flex align-items-center justify-content-end">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item">
                            <a href="/Home/Index">Início</a>
                        </li>
                        <li class="breadcrumb-item active" aria-current="page">Questões</li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>
</div>
<!-- ============================================================== -->
<!-- End Bread crumb and right sidebar toggle -->
