<script type="text/javascript">
    $(function () {
        // Use Inputmask 5.x API
        try {
            Inputmask("999.999.999-99").mask(document.querySelector('input[name="cpf_busca"]'));
            Inputmask("99/99/9999").mask(document.querySelector('input[name="ate_dt_diario_oficial"]'));
            Inputmask("99/99/9999").mask(document.querySelector('input[name="ate_dt_ato"]'));
            Inputmask("99/99/9999").mask(document.querySelector('input[name="ate_dt_validade"]'));
            Inputmask("99/99/9999").mask(document.querySelector('input[name="ate_dt_final"]'));
        } catch (e) {
            console.error('Inputmask initialization error:', e);
        }
    });
</script>
