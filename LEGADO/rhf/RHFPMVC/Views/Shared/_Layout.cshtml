        <script type="text/javascript">
            // Hover expand functionality for horizontal navbar and sidebar menus
            $(document).ready(function () {
                var hoverTimeout;

                // Handle hover on items with submenus (navbar-horizontal)
                $('nav.navbar-horizontal').on('mouseenter', '.sidebar-item', function () {
                    clearTimeout(hoverTimeout);
                    var $link = $(this).find('.has-arrow');
                    var $submenu = $(this).find('.collapse.first-level');
                    if ($submenu.length && $link.length) {
                        $link.attr('aria-expanded', 'true');
                        $submenu.stop(true, true).slideDown(150, function () {
                            $(this).css('display', 'block');
                        });
                    }
                }).on('mouseleave', '.sidebar-item', function () {
                    var $this = $(this);
                    var $link = $this.find('.has-arrow');
                    var $submenu = $this.find('.collapse.first-level');

                    hoverTimeout = setTimeout(function () {
                        if ($submenu.length && $link.length) {
                            $link.attr('aria-expanded', 'false');
                            $submenu.stop(true, true).slideUp(150, function () {
                                $(this).css('display', 'none');
                            });
                        }
                    }, 100);
                });

                // Handle hover on items with submenus (left sidebar)
                $('aside.left-sidebar').on('mouseenter', '.sidebar-item', function () {
                    clearTimeout(hoverTimeout);
                    var $link = $(this).find('.sidebar-link.has-arrow');
                    var $submenu = $(this).find('.collapse.first-level');
                    if ($submenu.length && $link.length) {
                        $link.attr('aria-expanded', 'true');
                        $submenu.stop(true, true).slideDown(150, function () {
                            $(this).css('display', 'block');
                        });
                    }
                }).on('mouseleave', '.sidebar-item', function () {
                    var $this = $(this);
                    var $link = $this.find('.sidebar-link.has-arrow');
                    var $submenu = $this.find('.collapse.first-level');

                    hoverTimeout = setTimeout(function () {
                        if ($submenu.length && $link.length) {
                            $link.attr('aria-expanded', 'false');
                            $submenu.stop(true, true).slideUp(150, function () {
                                $(this).css('display', 'none');
                            });
                        }
                    }, 100);
                });
            });
        </script>



