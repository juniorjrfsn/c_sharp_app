<style type="text/css">
    .footer {
        position: page;
        bottom: 0;
    }

    /* Garante que o modal do SweetAlert2 (janela de "carregando") sempre
       apareça por cima de qualquer elemento da página (sidebar, navbar,
       preloader, etc.), independente de z-index/transform herdados do
       template. Definir isso via CSS, e não via JS após o Swal.fire(),
       evita qualquer atraso/"flash" em que o modal fica escondido. */
    .swal2-container {
        z-index: 2147483647 !important;
    }
</style>

<script type="text/javascript">
    $(function () {
        // Use Inputmask 5.x API
        try {
            if (typeof Inputmask !== 'undefined') {
                Inputmask("999.999.999-99").mask(document.querySelector('input[name="cpf_busca"]'));
                Inputmask("99/9999").mask(document.querySelector('input[name="per_dt_ini"]'));
                Inputmask("99/9999").mask(document.querySelector('input[name="per_dt_fim"]'));
            }
        } catch (e) {
            console.error('Inputmask initialization error:', e);
        }
    });
</script>