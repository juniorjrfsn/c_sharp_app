<script type="text/javascript">
    $(function () {
        try {
            const mascaras = [
                ['input[name="cpf_busca"]', '999.999.999-99'],
                ['input[name="dpe_cpf_servidor"]', '999.999.999-99'],
                ['input[name="dpe_dt_nascimento"]', '99/99/9999'],
                ['input[name="per_dt_ini"]', '99/9999'],
                ['input[name="per_dt_fim"]', '99/9999']
            ];

            mascaras.forEach(([selector, mask]) => {
                const input = document.querySelector(selector);
                if (input) {
                    Inputmask(mask).mask(input);
                }
            });
        } catch (e) {
            console.error('Inputmask initialization error:', e);
        }
    });
</script>